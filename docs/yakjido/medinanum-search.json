때","k":["다래끼","눈","눈꺼풀","맥립종","산립종","눈다래끼","결막염","눈두덩"],"u":"#/symptom/stye"},{"id":"s:gastroenteritis","t":"장염 (토하고 설사할 때)","s":"물처럼 설사하고 토할 때","k":["장염","위장염","토함","구토","설사","복통","식중독","노로"],"u":"#/symptom/gastroenteritis"},{"id":"s:uti","t":"방광염 (소변이 아플 때)","s":"소변이 잦고 따가울 때","k":["방광염","요로감염","소변","배뇨통","빈뇨","잔뇨","오줌","신우신염"],"u":"#/symptom/uti"},{"id":"s:conjunctivitis","t":"눈병 (충혈·눈곱)","s":"눈이 빨갛고 눈곱이 낄 때","k":["눈병","결막염","충혈","눈곱","유행성","아폴로","눈"],"u":"#/symptom/conjunctivitis"},{"id":"s:nosebleed","t":"코피","s":"코피가 날 때","k":["코피","비출혈","코","출혈","지혈"],"u":"#/symptom/nosebleed"},{"id":"s:frozen-shoulder","t":"어깨가 안 올라갈 때 (오십견·회전근개)","s":"팔을 들기 어렵고 밤에 아플 때","k":["오십견","어깨","유착성","관절낭염","회전근개","팔","야간통"],"u":"#/symptom/frozen-shoulder"},{"id":"s:incontinence","t":"요실금 (소변이 샐 때)","s":"기침할 때 찔끔, 참기 힘들 때","k":["요실금","소변","지림","찔끔","새는","오줌","과민성방광","야간뇨"],"u":"#/symptom/incontinence"},{"id":"s:bph","t":"소변이 시원찮을 때 (전립선비대)","s":"줄기가 약하고 밤에 자주 깰 때","k":["전립선","전립선비대","야간뇨","소변줄기","잔뇨","소변","밤에","오줌"],"u":"#/symptom/bph"},{"id":"s:osteoporosis","t":"골다공증 · 뼈가 약해질 때","s":"아프지 않아서 더 위험한 병","k":["골다공증","뼈","골절","골밀도","키가 줄었","허리가 굽","포사맥스","칼슘"],"u":"#/symptom/osteoporosis"},{"id":"s:sprain","t":"발목 삠·타박상","s":"접질리고 부어오른","k":["발목","삠","접질","염좌","타박상","멍","삐끗"],"u":"#/symptom/sprain"},{"id":"s:tendon","t":"손목·팔꿈치 건초염·테니스엘보","s":"쥐거나 비틀면 팔꿈치 바깥·엄지 쪽 손목이 시큰한","k":["손목","팔꿈치","건초염","테니스엘보","힘줄","방아쇠수지","시큰"],"u":"#/symptom/tendon"},{"id":"s:plantar","t":"족저근막염·발뒤꿈치 통증","s":"아침 첫걸음에 발뒤꿈치가 찌릿한","k":["족저근막염","발뒤꿈치","발바닥","첫걸음","뒤꿈치"],"u":"#/symptom/plantar"},{"id":"s:coldsore","t":"입술 포진","s":"입술 가장자리가 따끔거리다 물집이 잡히는","k":["입술","물집","헤르페스","포진","입술물집","따끔"],"u":"#/symptom/coldsore"},{"id":"s:eczema","t":"습진·아토피 가려움","s":"팔 안쪽·목·손이 건조하고 붉게 가려운","k":["습진","아토피","건조","가려움","피부","각질","가려워","가려운"],"u":"#/symptom/eczema"},{"id":"s:acne","t":"여드름","s":"이마·턱에 붉은 여드름과 좁쌀이 계속 나는","k":["여드름","뾰루지","좁쌀","피지","트러블"],"u":"#/symptom/acne"},{"id":"s:vaginitis","t":"질염 가려움·냉","s":"가렵고 하얀 냉이 늘어난","k":["질염","냉","가려움","칸디다","분비물","외음부"],"u":"#/symptom/vaginitis"},{"id":"s:pms","t":"생리 전 증후군(월경전증후군)","s":"생리 전 며칠 붓고 예민하고 머리·허리가 아픈","k":["생리전","PMS","월경전증후군","붓기","예민","가슴통증"],"u":"#/symptom/pms"},{"id":"s:meno","t":"갱년기 증상","s":"얼굴이 확 달아오르고 잠이 안 오고 짜증이 늘어난","k":["갱년기","폐경","안면홍조","열감","식은땀","홍조"],"u":"#/symptom/meno"},{"id":"s:fatigue","t":"피로·기력 저하","s":"몇 주째 자도 피곤하고 힘이 없는","k":["피로","기력","무기력","피곤","만성피로","기운없"],"u":"#/symptom/fatigue"},{"id":"s:drymouth","t":"입이 마름","s":"입이 바싹 마르고 밤에 깨서 물을 찾는","k":["입마름","구강건조","침","혀","입안","건조","목마름","마름"],"u":"#/symptom/drymouth"},{"id":"s:gumdisease","t":"잇몸이 붓고 피가 남","s":"칫솔질할 때 피가 나고 잇몸이 들뜨는","k":["잇몸","치주염","치은염","잇몸출혈","인사돌","이가탄","풍치","치석"],"u":"#/symptom/gumdisease"},{"id":"s:ibs","t":"배가 자주 아프고 변이 오락가락","s":"몇 달째 배가 아프고 설사와 변비가 번갈아 오는","k":["과민성대장","과민성대장증후군","복통","배아픔","설사","변비","가스","더부룩"],"u":"#/symptom/ibs"},{"id":"s:burn","t":"데었을 때(화상)","s":"끓는 물·기름·다리미에 데어 붉고 따가운","k":["화상","데임","물집","덴데","끓는물","기름","다리미","햇볕화상"],"u":"#/symptom/burn"},{"id":"s:numbness","t":"손발이 저리고 남의 살 같음","s":"손발 끝이 저리고 밤에 더 심한","k":["저림","손저림","발저림","말초신경","당뇨신경병","수근관","척추관","손"],"u":"#/symptom/numbness"},{"id":"s:anxiety","t":"불안·긴장 (가슴이 두근거릴 때)","s":"조마조마하고 가슴이 두근거리는","k":["불안","긴장","공황","두근거림","초조","떨림","조마조마"],"u":"#/symptom/anxiety"},{"id":"s:earwax","t":"귀가 먹먹하고 잘 안 들릴 때 (귀지)","s":"귀가 먹먹할 때","k":["귀지","귀","먹먹","귀막힘","이물감","잘 안 들림","귀청소","면봉"],"u":"#/symptom/earwax"},{"id":"s:tinnitus","t":"귀에서 소리가 날 때 (이명)","s":"귀에서 삐— 소리","k":["이명","귀울림","삐소리","매미소리","윙","귀에서 소리"],"u":"#/symptom/tinnitus"},{"id":"s:deworm","t":"구충제 (요충·회충)","s":"구충제를 먹어야 할 때","k":["구충","구충제","기생충","요충","회충","항문 가려움","알벤다졸"],"u":"#/symptom/deworm"},{"id":"s:smoking","t":"담배를 끊고 싶을 때 (금연)","s":"혼자 참지 않는 법","k":["금연","담배","흡연","니코틴","니코틴패치","패치","니코틴껌","껌"],"u":"#/symptom/smoking"},{"id":"s:hairloss","t":"머리카락이 빠질 때 (탈모)","s":"미녹시딜은 넉 달부터","k":["탈모","머리빠짐","머리카락","미녹시딜","정수리","이마","원형탈모","머리숱"],"u":"#/symptom/hairloss"},{"id":"s:corn","t":"티눈·굳은살 (발바닥이 콕콕 아플 때)","s":"누르는 신발부터","k":["티눈","굳은살","발바닥","못","티눈고","티눈밴드","발가락","콕콕"],"u":"#/symptom/corn"},{"id":"d:acetaminophen","t":"아세트아미노펜","s":"위장 부담이 가장 적은 기본 진통·해열제","k":["두통","치통","생리통","근육통","발열","감기 몸살","타이레놀정","타이레놀","어린이","세토펜정·현탁액"],"u":"#/drug/acetaminophen"},{"id":"d:ibuprofen","t":"이부프로펜","s":"일반약 소염진통제 중 위장 부담이 가장 낮은 편","k":["근육·관절통","생리통","치통","두통","발열","염좌","부루펜정","이지엔6","캐롤에프정","어린이"],"u":"#/drug/ibuprofen"},{"id":"d:dexibuprofen","t":"덱시부프로펜","s":"이부프로펜의 ‘활성형 절반’ — 더 적은 양으로 같은 효과","k":["근육·관절통","생리통","치통","두통","발열","이지엔6","맥시부펜"],"u":"#/drug/dexibuprofen"},{"id":"d:naproxen","t":"나프록센","s":"오래 가고 심근경색·뇌졸중 위험이 가장 덜 오르는 소염제, 대신 위장엔 덜 친절","k":["생리통","근육·관절통","치통","두통","염좌","탁센","낙센연질캡슐"],"u":"#/drug/naproxen"},{"id":"d:aspirin","t":"아스피린","s":"진통제로는 이제 1순위가 아닌 약 — 저용량은 ‘심장약’","k":["두통·근육통(2순위)","혈전 예방(저용량 100 mg, 의사 지시)","바이엘아스피린정","아스피린프로텍트정"],"u":"#/drug/aspirin"},{"id":"d:diclofenac","t":"디클로페낙 (먹는약)","s":"효과는 강하지만 심혈관 부담이 가장 큰 편 — 처방약","k":["관절염","근골격 통증(처방)","신일디클로페낙나트륨정"],"u":"#/drug/diclofenac"},{"id":"d:aceclofenac","t":"아세클로페낙","s":"디클로페낙의 순한 사촌 — 국내 처방 1순위급","k":["관절염","근골격 통증(처방)","에어탈정"],"u":"#/drug/aceclofenac"},{"id":"d:celecoxib","t":"셀레콕시브","s":"위장을 아끼도록 설계된 염증 효소만 골라 막는 약 — 처방약","k":["관절염","오래된 통증(처방)","쎄레브렉스"],"u":"#/drug/celecoxib"},{"id":"d:meloxicam","t":"멜록시캄","s":"하루 한 번 처방 소염제 — ‘부분 선택’이라 위장 이득은 크지 않음","k":["관절염(처방)","모빅"],"u":"#/drug/meloxicam"},{"id":"d:loxoprofen","t":"록소프로펜","s":"붙이는 것은 약국, 먹는 것은 처방 — 같은 성분 다른 분류","k":["근골격 통증","관절염","발치 후 통증(처방)","록소닌정","록소나카타플라스마","레녹스카타플라스마"],"u":"#/drug/loxoprofen"},{"id":"d:ipa","t":"이소프로필안티피린 (게보린 성분)","s":"게보린의 진통 성분 — 15세 미만 금지, 단기만","k":["두통","치통","생리통(단기)","게보린정"],"u":"#/drug/ipa"},{"id":"d:ethenzamide","t":"에텐자미드 (펜잘 성분)","s":"펜잘큐의 살리실산계 진통 성분 — 15세 미만엔 권하지 않음","k":["두통","치통","생리통","펜잘큐정"],"u":"#/drug/ethenzamide"},{"id":"d:caffeine","t":"카페인 (진통 보조)","s":"진통제 효과를 조금 높이지만, 매일 먹으면 두통을 만들어요","k":["진통 보조","게보린·펜잘큐·그날엔·판피린"],"u":"#/drug/caffeine"},{"id":"d:pamabrom","t":"파마브롬 (이지엔6 이브 성분)","s":"생리 전 붓기를 빼는 약한 이뇨 성분","k":["생리 전 붓기","이지엔6"],"u":"#/drug/pamabrom"},{"id":"d:chlorzoxazone","t":"클로르족사존 (일반약 근이완 성분)","s":"약국에서 살 수 있는 유일한 근이완 성분 — 3제 복합제로만","k":["담 결림","근육 뭉침·경직","갑자기 온 허리 통증(보조)","신신플렉스정·클리담정·리렉스담정"],"u":"#/drug/chlorzoxazone"},{"id":"d:eperisone","t":"에페리손 (처방 근이완제)","s":"국내 처방 1순위 근이완제 — 졸음이 덜한 편","k":["근골격 통증 동반 근육 경직","갑자기 온 허리 통증·경부통(처방)","뮤렉스정·에페리손염산염정"],"u":"#/drug/eperisone"},{"id":"d:cyclobenzaprine","t":"사이클로벤자프린 (처방 근이완제)","s":"밤에 쓰는 근이완제 — 졸음이 강함","k":["갑자기 온 근육 경련(처방)","시클펜정"],"u":"#/drug/cyclobenzaprine"},{"id":"d:famotidine","t":"파모티딘 10 mg (약국)","s":"약국에서 살 수 있는 가장 강한 위산 억제제 — 10 mg만 일반의약품","k":["속쓰림·신물","소염제를 먹으며 속이 쓰릴 때","위산과다","파미딘정·팜시드정·파모윈정·파탁정"],"u":"#/drug/famotidine"},{"id":"d:omeprazole","t":"오메프라졸·에스오메프라졸 (강한 위산 억제제)","s":"가장 강한 위산 억제제 — 국내에선 처방약","k":["역류성 식도염","위궤양","소염제 위보호(처방)","오메드정·넥시움정·에소메졸"],"u":"#/drug/omeprazole"},{"id":"d:almagate","t":"알마게이트 (알마겔)","s":"지금 당장 속쓰림을 끄는 제산제","k":["속쓰림·신물","위통(일시적)","알마겔현탁액","알마겔에프현탁액","알마겔정"],"u":"#/drug/almagate"},{"id":"d:aluminium-phosphate","t":"인산알루미늄 (겔포스)","s":"점막을 덮어 주는 제산제 — 빈속 통증에","k":["속쓰림","위통","위염 증상","겔포스엠"],"u":"#/drug/aluminium-phosphate"},{"id":"d:alginate","t":"알긴산 (개비스콘)","s":"위 위에 ‘뗏목’을 띄워 역류를 막는 약","k":["역류(신물·가슴쓰림)","식후 속쓰림","개비스콘"],"u":"#/drug/alginate"},{"id":"d:antacid-mg","t":"수산화마그네슘 (제산 성분)","s":"제산제 속 마그네슘 — 변을 무르게 하는 쪽","k":["제산(복합제 성분)","겔포스엠현탁액"],"u":"#/drug/antacid-mg"},{"id":"d:digestive-enzyme","t":"소화효소제 (훼스탈·베아제)","s":"과식 후 더부룩함에 — 위산·통증에는 아님","k":["과식 후 더부룩함","가스·트림","훼스탈","베아제정"],"u":"#/drug/digestive-enzyme"},{"id":"d:simethicone","t":"시메티콘","s":"가스 거품을 터뜨리는 성분 — 흡수되지 않아 안전","k":["가스 참","더부룩함","훼스탈·베아제·겔포스엠"],"u":"#/drug/simethicone"},{"id":"d:loperamide","t":"로페라마이드","s":"설사를 멈추는 약 — 열·혈변이 있으면 절대 금지","k":["갑자기 생긴 물설사(열·혈변 없는)","로프민캡슐·로페린"],"u":"#/drug/loperamide"},{"id":"d:smectite","t":"스멕타이트 (지사 흡착제)","s":"독소·수분을 흡착하는 지사제 — 어린이·임신·수유 중 금지","k":["갑자기 시작된 설사(보조)","스타빅현탁액","다이톱현탁액"],"u":"#/drug/smectite"},{"id":"d:bisacodyl","t":"비사코딜 (자극성 변비약)","s":"밤에 먹고 아침에 — 급할 때 쓰는 자극성 완하제","k":["갑자기 생긴 변비","여행 변비","둘코락스에스","메이킨큐"],"u":"#/drug/bisacodyl"},{"id":"d:magnesium-oxide","t":"마그네슘 변비약 (마그밀·마그밀에스)","s":"매일 써도 되는 순한 삼투성 변비약 — 신장이 나쁘면 금지","k":["오래된·습관성 변비","제산(보조)","마그밀정(수산화마그네슘)","마그밀에스정(산화마그네슘)"],"u":"#/drug/magnesium-oxide"},{"id":"d:corn-unsap","t":"옥수수불검화정량추출물 (인사돌 등)","s":"잇몸약 — 치과 치료를 받은 뒤 '보조'로만","k":["인사돌정","인사돌플러스정"],"u":"#/drug/corn-unsap"},{"id":"d:gum-combo","t":"잇몸 복합제 (이가탄 등)","s":"카르바조크롬·아스코르브산·토코페롤·리소짐 — 역시 '보조'","k":["이가탄에프캡슐","이덴큐캡슐","덴타나캡슐"],"u":"#/drug/gum-combo"},{"id":"d:chx-gel","t":"클로르헥시딘 잇몸 겔·가글","s":"잇몸 염증에 실제로 듣는 소독 성분 — 단, 2주까지만","k":["헥사메딘액","페리오가드"],"u":"#/drug/chx-gel"},{"id":"d:saliva-sub","t":"인공타액·구강 보습 겔","s":"입마름에 덧발라 주는 것 — 침을 만들어 주지는 않아요","k":["드라이문트겔","자이리덴트"],"u":"#/drug/saliva-sub"},{"id":"d:xylitol-gum","t":"무설탕 자일리톨 껌·캔디","s":"씹어서 침을 돌게 하는 것 — 입마름의 1순위","k":[],"u":"#/drug/xylitol-gum"},{"id":"d:peppermint-oil","t":"페퍼민트 오일 (장용 캡슐)","s":"배 아픈 과민성대장에 — 4명 중 1명이 덕을 봐요(국내에도 일반의약품이 있어요)","k":["장트라올라장용연질캡슐"],"u":"#/drug/peppermint-oil"},{"id":"d:acetylcysteine","t":"아세틸시스테인 (뮤테란)","s":"끈적한 가래를 묽게 — 진료실 감기 처방의 단골","k":["끈적한 가래","기관지염·감기 뒤 가래","뮤테란캡슐200밀리그램","뮤테란과립200밀리그램"],"u":"#/drug/acetylcysteine"},{"id":"d:mosapride","t":"모사프리드 (가스모틴)","s":"위를 움직이게 하는 처방약 — 소염제 먹는 동안 더부룩할 때","k":["소화불량·더부룩함","약 먹는 동안 메스꺼움","가스모틴정"],"u":"#/drug/mosapride"},{"id":"d:cefixime","t":"세픽심 (슈프락스)","s":"3세대 세팔로스포린 — 부비동염·편도염·중이염에, 끝까지","k":["부비동염·편도염·중이염","요로감염","동아슈프락스캡슐"],"u":"#/drug/cefixime"},{"id":"d:dihydrocodeine","t":"디히드로코데인 (코데인계 진해 성분)","s":"기침 중추를 누르는 코데인계 — 12세 미만 금지, 졸음·변비","k":["밤에 잠을 못 자게 하는 마른기침"],"u":"#/drug/dihydrocodeine"},{"id":"d:cough-syrup-rx","t":"처방 기침 시럽 (코푸시럽)","s":"기침·콧물·코막힘·가래를 한 병에 — 밤용, 운전 금지","k":["밤 기침·콧물·코막힘이 함께 올 때","코푸시럽"],"u":"#/drug/cough-syrup-rx"},{"id":"d:propranolol","t":"프로프라놀롤 (인데놀)","s":"불안의 「몸 증상」을 눌러 주는 처방약 — 두근거림·손떨림","k":["공황 발작의 두근거림","발표·시험 전 손떨림","본태성 진전","인데놀정"],"u":"#/drug/propranolol"},{"id":"d:hydroxyzine","t":"히드록시진 (1세대 항히스타민)","s":"졸음으로 긴장을 눅이는 처방 항히스타민 — 1차 약은 아니에요","k":["불안에 동반된 긴장·불면","가려움","아디팜정"],"u":"#/drug/hydroxyzine"},{"id":"d:peg","t":"폴리에틸렌글리콜 (폴락스·마이락스)","s":"변비약 중 근거가 가장 좋은데, 약국에서 살 수 있어요","k":["변비","변이 딱딱해서 힘든 분","오래된 변비","폴락스산","마이락스산","이지락스액","폴락스산4그램"],"u":"#/drug/peg"},{"id":"d:benzoyl-peroxide","t":"과산화벤조일 (여드름 겔)","s":"약국 여드름약 중 근거가 가장 좋고, 내성이 안 생겨요","k":["여드름(보통 여드름)","등·가슴 여드름","벤작에이씨겔2.5%","파티마겔2.5%","톡클리어겔5%"],"u":"#/drug/benzoyl-peroxide"},{"id":"d:topical-steroid","t":"바르는 스테로이드 (약국에서 살 수 있는 단계)","s":"가려움·습진에 가장 확실한 약 — 정해진 기간만 짧게","k":["습진·피부염","가려움","벌레 물린 데","땀띠","두드러기","락티케어에취씨로션1%","더마크린에취씨로션1%","삼아리도멕스크림0.15%"],"u":"#/drug/topical-steroid"},{"id":"d:acyclovir-cream","t":"아시클로버 크림 (입술 물집)","s":"따끔할 때 바로 시작해야 값을 해요","k":["입술 물집(구순포진)","단순포진 재발","바시락크림","국제아시클로버크림","녹십자아시클로버크림"],"u":"#/drug/acyclovir-cream"},{"id":"d:clotrimazole-vag","t":"클로트리마졸 질정 (칸디다 질염)","s":"곰팡이 질염이 맞을 때만 들어요","k":["칸디다 질염(곰팡이 질염)","카네스텐1질정","카네마졸질정100","카네스텐질정"],"u":"#/drug/clotrimazole-vag"},{"id":"d:felbinac","t":"펠비낙 파스 (뉴비낙·노펜펠비낙 등)","s":"케토톱만 있는 게 아니에요 — 약국 소염 파스의 또 한 갈래","k":["관절염","어깨 통증","건초염·테니스엘보","근육통","삔 뒤의 붓기","뉴비낙플라스타","노펜펠비낙카타플라스마","뉴펜스탑카타플라스마"],"u":"#/drug/felbinac"},{"id":"d:ibuprofen-patch","t":"이부프로펜 파스 (이부스타·이부쿨 등)","s":"하루 한 번만 붙이면 되는 소염 파스","k":["관절염","어깨 통증","건초염·테니스엘보","근육통","삔 뒤의 붓기","이부스타플라스타","맨담이부쿨플라스타","이프로탑플라스타"],"u":"#/drug/ibuprofen-patch"},{"id":"d:erdosteine","t":"에르도스테인 (엘도스)","s":"가래를 묽게 — 하루 두세 번","k":["가래 기침","가래가 끈적해 안 떨어질 때","엘도스캡슐","뉴에르도테캡슐"],"u":"#/drug/erdosteine"},{"id":"d:ambroxol","t":"암브록솔 (뮤코펙트 계열)","s":"가래를 묽게 — 하루 세 번, 좋아지면 두 번","k":["가래 기침","기관지염","넥스팜염산암부록솔정","다이투스정"],"u":"#/drug/ambroxol"},{"id":"d:povidone-iodine","t":"포비돈요오드 (포비딘·베타딘)","s":"상처 소독의 기본 — 다만 「깨끗한 생채기」에는 물이 나아요","k":["상처 소독","화상 부위 소독","목 살균(스프레이)","포비딘인후스프레이액","큐앤큐포비돈거즈볼"],"u":"#/drug/povidone-iodine"},{"id":"d:albendazole","t":"알벤다졸 (구충제)","s":"요충은 「7일 뒤 한 번 더」 — 그리고 온 가족이 같이","k":["구충","항문이 가려울 때(요충)","다산알벤다졸정400밀리그램","다졸정"],"u":"#/drug/albendazole"},{"id":"d:genta-steroid-cream","t":"겐타마이신 복합 연고 (나이베라·노바손 등)","s":"긁어서 곪은 습진에 — 스테로이드와 항생제가 함께","k":["긁어서 곪은 습진","진물이 나는 피부염","1도 화상","나이베라크림","노바손크림"],"u":"#/drug/genta-steroid-cream"},{"id":"d:probiotic-otc","t":"정장제 (비오플·메디락 등)","s":"약국에서 파는 유산균 — 항생제 설사에 쓸 만해요","k":["묽은 변·설사","항생제 드시는 동안","비오플250산","메디락디에스장용캡슐"],"u":"#/drug/probiotic-otc"},{"id":"d:ginkgo","t":"은행잎 추출물 (기넥신·타나민)","s":"진료실에서 어지럼에 자주 내는 약 — 베타히스틴만큼은 하지만, 그 베타히스틴이 문제예요","k":["어지럼(원인을 확인한 뒤 보조)","손발 저림·말초 순환","기억력 저하(보조)","기넥신에프정","타나민정"],"u":"#/drug/ginkgo"},{"id":"d:nicotine-patch","t":"니코틴패치 (금연 보조제)","s":"담배 대신 니코틴을 피부로 천천히 — 끊을 때 오는 금단을 줄여요","k":["담배를 끊을 때 금단 증상 줄이기","니코틴엘TTS10·20·30","니코스탑-10·20·30패취","니코레트인비지패취"],"u":"#/drug/nicotine-patch"},{"id":"d:nicotine-gum","t":"니코틴껌 (금연 보조제)","s":"피우고 싶은 순간에 바로 — 씹다가 물고 있는 약","k":["담배를 끊을 때 갑자기 몰려오는 흡연 충동","니코레트껌","니코에이껌"],"u":"#/drug/nicotine-gum"},{"id":"d:minoxidil","t":"미녹시딜 (바르는 탈모약)","s":"서서히 옅어지는 유전형 탈모에 — 넉 달은 꾸준히","k":["남성형 탈모(정수리·이마가 서서히)","여성형 탈모(정수리 쪽이 넓게 옅어짐) — 2~3% 제품만","마이녹실액","나녹시딜액","로게인"],"u":"#/drug/minoxidil"},{"id":"d:salicylic-corn","t":"티눈약 (살리실산 반창고·물약)","s":"딱딱한 살을 무르게 해서 벗겨 내요 — 티눈 자리에만","k":["티눈","굳은살(못)","사마귀 (반창고 제품 — 헷갈리면 피부과에서 먼저 확인)","신신티눈고","티눈스립에이액","콜로덤에스액"],"u":"#/drug/salicylic-corn"},{"id":"d:domperidone","t":"돔페리돈 (메스꺼움·구토 약)","s":"메스껍고 토할 때 짧게 — 일주일을 넘기지 않아요","k":["메스꺼움","구토","멕시롱액","그린큐액","크리맥액"],"u":"#/drug/domperidone"},{"id":"d:ketoconazole-shampoo","t":"케토코나졸 샴푸 (비듬·지루피부염)","s":"비듬 원인 곰팡이를 줄이는 약용 샴푸 — 3~5분 두었다 헹궈요","k":["비듬","지루피부염(두피·얼굴)","어루러기","니조랄","나졸액","비가졸액"],"u":"#/drug/ketoconazole-shampoo"},{"id":"d:ciclopirox-shampoo","t":"시클로피록스 샴푸 (지루피부염)","s":"케토코나졸과 효과가 비슷한 다른 계열의 항진균 샴푸","k":["지루피부염(두피)","노비프록스액","덴드로프-쿨액","클록스액"],"u":"#/drug/ciclopirox-shampoo"},{"id":"d:coughs-combo","t":"코푸시럽에스·코푸정에스 (기침·가래 복합)","s":"기침을 누르고 가래를 묽게 — 졸리고, 다른 감기약과 겹치면 안 돼요","k":["기침","가래","코푸시럽에스","코푸정에스","코푸엔에스시럽"],"u":"#/drug/coughs-combo"},{"id":"d:yonggaksan","t":"용각산쿨 (생약 + 노스카핀, 기침·목 불편)","s":"물 없이 입에 털어 넣는 생약 기침 가루 — 감초가 들어 있어요","k":["기침","가래","목쉼·목 불편","용각산쿨과립"],"u":"#/drug/yonggaksan"},{"id":"d:carbocisteine","t":"카르보시스테인 (가래 묽게 하는 약)","s":"끈적한 가래를 묽게 — 위궤양이 있으면 피하세요","k":["끈적한 가래","부비동염의 콧물·배농","리나치올캡슐","리나치올시럽"],"u":"#/drug/carbocisteine"},{"id":"d:udca","t":"우르소데옥시콜산 (우루사 성분)","s":"쓸개즙 분비를 돕는 성분 — 「간 피로」에 효과를 보인 시험은 없어요","k":["담즙(쓸개즙) 분비가 부족해 생긴 간·담도 질환의 보조 치료(허가 효능)","만성 간질환의 간기능 개선 보조(허가 효능)","간장약·간 영양제로 찾으시는 분이 많은 성분","우루사정100밀리그램","우루사100밀리그램연질캡슐","베아제정·훼스탈플러스정"],"u":"#/drug/udca"},{"id":"d:urea-cream","t":"요소(우레아) 크림 (건조·갈라진 피부)","s":"거칠고 갈라지는 어르신 피부·발뒤꿈치에 — 상처·짓무른 곳엔 따가워요","k":["노인성 건조 피부(가려운 건조 피부)","손·발바닥이 두껍게 갈라질 때(발뒤꿈치)","주부습진의 건조형·어린선","두꺼운 각질(발뒤꿈치·손발바닥)","한미유리아크림200밀리그램","태극우레아연고250밀리그램","유라덤크림"],"u":"#/drug/urea-cream"},{"id":"d:eye-decongestant","t":"충혈 안약 (나파졸린·테트라히드로졸린)","s":"빨간 눈을 잠깐 하얗게 — 며칠만, 좁은각 녹내장이면 금지","k":["먼지·수영·피로 뒤 일시적인 눈 충혈","눈 가려움·자극의 일시 완화(항히스타민이 함께 든 제품)","빨간 눈(충혈)","나조린점안액","뉴브이로토이엑스점안액","아이미루40이엑스점안액"],"u":"#/drug/eye-decongestant"},{"id":"d:allergy-eyedrop","t":"알레르기 안약 (케토티펜·크로몰린)","s":"꽃가루·먼지로 가렵고 눈물 나는 눈에 — 1주 넘게 안 나으면 안과","k":["알레르기성 결막염(꽃가루·먼지·동물털로 가렵고 눈물 나는 눈)","봄철 결막염(크로몰린)","눈 가려움·눈물(알레르기)","알러콘점안액","알러펜점안액","아이크롬점안액"],"u":"#/drug/allergy-eyedrop"},{"id":"d:oral-contraceptive","t":"먹는 피임약 (복합 경구피임제)","s":"매일 같은 시간 한 알 — 35세 넘어 담배를 피우면 먹지 않아요","k":["피임","머시론정","마이보라정","에이리스정"],"u":"#/drug/oral-contraceptive"},{"id":"d:clonixin","t":"클로닉신 (약국 소염진통제)","s":"약국에서 파는 소염진통제 — 다른 진통제·피 묽게 하는 약과 겹치지 않게","k":["근육통·신경통","두통·치통·귀 통증","외상·수술 뒤 통증(가볍거나 중간 정도)","클로나인연질캡슐","프리에스연질캡슐"],"u":"#/drug/clonixin"},{"id":"d:ciclopirox-nail","t":"시클로피록스 네일라카 (손발톱 무좀)","s":"발톱 무좀에 바르는 매니큐어 — 완치는 100명 중 5~8명, 오래 걸려요","k":["손발톱 무좀(가볍고 발톱 한두 개일 때)","로푸록스네일라카","풀케어네일라카"],"u":"#/drug/ciclopirox-nail"},{"id":"d:naftifine","t":"나프티핀 (엑소데릴 등 무좀 크림·액)","s":"테르비나핀과 같은 계열 무좀약 — 하루 한 번, 나은 뒤 2주 더","k":["발 무좀(족부백선)·손·사타구니·몸 백선","피부 칸디다증·어루러기","일동엑소데릴크림","일동엑소데릴액"],"u":"#/drug/naftifine"},{"id":"d:scar-gel","t":"흉터 연고 (헤파린·알란토인·양파추출물 겔)","s":"상처가 다 아문 뒤에 — 다른 흉터 관리보다 낫다는 근거는 없어요","k":["수술·화상·상처 뒤 두꺼워지거나 붉은 흉터","여드름 흉터(노스카나 계열 허가 효능)","벤트락스겔","노스카나겔"],"u":"#/drug/scar-gel"},{"id":"d:bruise-gel","t":"멍·부기 겔 (헤파린·에스신·살리실산글리콜)","s":"타박상 멍·정맥류 부기에 — 한쪽 다리가 붓고 아프면 겔 말고 진료","k":["타박상·운동 부상의 멍·부기","정맥류로 인한 다리 부기","표재성 정맥염(피부 가까운 정맥의 염증)","멍 빼는 데(타박상)","베노플러스겔","타바겐겔"],"u":"#/drug/bruise-gel"},{"id":"d:lidocaine-pe","t":"리도카인 크림 (남성 조루 완화)","s":"관계 5~15분 전에 조금 — 하루 최대 2 g, 상대가 임신 중이면 쓰지 않아요","k":["조루(사정이 너무 빨라 불편할 때)","리도카인"],"u":"#/drug/lidocaine-pe"},{"id":"d:neomycin-combo","t":"네오마이신 복합 연고 (마데카솔케어·바네포 등)","s":"덧난 상처에 짧게 — 깨끗한 생채기는 씻고 덮는 것으로 충분한 경우가 많고, 연고 알레르기가 드물지 않아요","k":["작은 상처·긁힌 상처·가벼운 화상이 덧났을 때(고름·붉어짐)","마데카솔케어연고","바네포연고"],"u":"#/drug/neomycin-combo"},{"id":"d:hydroquinone","t":"하이드로퀴논 크림 (기미·검버섯 미백)","s":"기미를 천천히 옅게 — 2개월 써 보고 판단, 햇빛 가리기가 함께여야","k":["기미(흑피증)·주근깨","노인성 검은 반점(검버섯처럼 보이는 색소)","도미나크림","루스트라크림4%"],"u":"#/drug/hydroquinone"},{"id":"d:aluminium-chloride","t":"염화알루미늄 액 (다한증)","s":"땀이 너무 많을 때 — 자기 전에 바르고 아침에 씻기","k":["겨드랑이·손·발의 땀이 너무 많을 때(다한증)","드라이언액","노스엣액"],"u":"#/drug/aluminium-chloride"},{"id":"d:dexpanthenol","t":"덱스판테놀 (비판텐 연고·탈모 보조 정제)","s":"피부 장벽을 돕는 순한 연고 — 염증약·항생제를 대신하지는 못해요","k":["상처·가벼운 화상·햇볕에 탄 피부의 회복 보조","기저귀 발진·수유 중 젖꼭지 갈라짐","건조하게 갈라진 습진 자리(보조)","탈모 보조(정제 — 근거 약함)","비판텐연고","다모판텐정100밀리그램"],"u":"#/drug/dexpanthenol"},{"id":"d:tranexamic-melasma","t":"먹는 기미약 (트라넥삼산 — 트란시노2 등)","s":"먹는 기미약 — 비타민처럼 보여도 핵심은 「굳은 피가 안 녹게 하는」 지혈 성분, 2개월까지만","k":["기미(얼굴의 갈색 얼룩)","트란시노2정","트랜미정","더마화이트정"],"u":"#/drug/tranexamic-melasma"},{"id":"d:ketoprofen","t":"케토프로펜 파스 (케토톱)","s":"붙이는 소염제 — 효과 좋지만 ‘햇빛 2주 주의’","k":["근육통","염좌·타박","관절통(한 부위)","케토톱"],"u":"#/drug/ketoprofen"},{"id":"d:piroxicam","t":"피록시캄 패치 (트라스트)","s":"2일에 한 장 — 오래 가는 붙이는 소염제","k":["관절통","근육통(한 부위)","트라스트"],"u":"#/drug/piroxicam"},{"id":"d:diclofenac-topical","t":"디클로페낙 겔 (볼타렌 에멀겔)","s":"삐끗·타박에 바르는 소염제 — 시험에서 5명이 바르면 3명 정도가 덕을 봤어요","k":["염좌·타박","무릎·손 관절염","근육통(한 부위)","볼타렌"],"u":"#/drug/diclofenac-topical"},{"id":"d:flurbiprofen","t":"플루르비프로펜 (스트렙실 트로키)","s":"목 아플 때 녹여 먹는 소염제 — 11분 만에 첫 완화","k":["인후통","한 자리 통증(패치)","스트렙실"],"u":"#/drug/flurbiprofen"},{"id":"d:methyl-salicylate","t":"살리실산메틸 파스 (신신파스·제일쿨파프)","s":"편의점 파스 — 온파스(뻐근함) vs 냉파프(삐끗 초기)","k":["근육통·뻐근함","삐끗 초기(냉파프)","신신파스","제일쿨파프","안티푸라민"],"u":"#/drug/methyl-salicylate"},{"id":"d:menthol","t":"멘톨 (냉감 성분)","s":"시원한 느낌으로 통증을 가리는 성분","k":["한 자리 통증(보조)","가려움","파스·안티푸라민·목"],"u":"#/drug/menthol"},{"id":"d:chlorpheniramine","t":"클로르페니라민 (1세대 항히스타민)","s":"감기약 속 콧물 성분 — 졸리고, 노인에겐 위험","k":["콧물·재채기(감기)","두드러기(단기)","판콜에이·판피린티","콜대원·타이레놀콜드에스"],"u":"#/drug/chlorpheniramine"},{"id":"d:pseudoephedrine","t":"슈도에페드린 (코막힘)","s":"코막힘에 가장 확실 — 단일제는 처방, 종합감기약 속에는 약국","k":["코막힘","코감기","슈도에페드린","콜대원"],"u":"#/drug/pseudoephedrine"},{"id":"d:phenylephrine","t":"페닐레프린 (코막힘)","s":"먹는 형태는 효과가 약하다는 평가 — 슈도에페드린의 대체","k":["코막힘(감기 복합제)","판콜에이","테라플루"],"u":"#/drug/phenylephrine"},{"id":"d:methylephedrine","t":"메틸에페드린 (기침·코막힘)","s":"국내 감기약 특유의 기관지 확장·코막힘 성분","k":["기침·코막힘(감기 복합제)","판피린큐·판콜에스·콜대원·화이투벤"],"u":"#/drug/methylephedrine"},{"id":"d:dextromethorphan","t":"덱스트로메토르판 (마른기침)","s":"기침 중추를 눌러 마른기침을 줄이는 성분","k":["마른기침","타이레놀"],"u":"#/drug/dextromethorphan"},{"id":"d:guaifenesin","t":"구아이페네신 (가래)","s":"가래를 묽게 해 뱉기 쉽게 — 물을 많이 마셔야 효과","k":["가래 기침","판콜에이","판피린큐·콜대원·화이투벤"],"u":"#/drug/guaifenesin"},{"id":"d:cetirizine","t":"세티리진 (지르텍)","s":"하루 한 알 2세대 항히스타민 — 졸음은 2세대 중 많은 편이라 자기 전에","k":["알레르기 비염","두드러기","가려움","지르텍정","세티리진"],"u":"#/drug/cetirizine"},{"id":"d:loratadine","t":"로라타딘 (클라리틴)","s":"졸음 거의 없는 하루 한 알 — 낮 활동용","k":["알레르기 비염","두드러기","가려움","클라리틴정"],"u":"#/drug/loratadine"},{"id":"d:fexofenadine","t":"펙소페나딘 (알레그라)","s":"졸음이 가장 적은 항히스타민제 — 과일주스와 먹지 말 것","k":["알레르기 비염","두드러기","알레그라정"],"u":"#/drug/fexofenadine"},{"id":"d:xylometazoline","t":"자일로메타졸린 (오트리빈 스프레이)","s":"뿌리면 몇 분 안에 코가 뚫림 — 단, 3일 규칙","k":["코막힘(감기·비염)","오트리빈","오트리빈"],"u":"#/drug/xylometazoline"},{"id":"d:mometasone","t":"스테로이드 비강분무제 (나조넥스 등)","s":"알레르기 비염 1차 치료 — 국내에선 처방약","k":["알레르기 비염(지속형)","코막힘","나조넥스·플릭소나제·아바미스"],"u":"#/drug/mometasone"},{"id":"d:diphenhydramine","t":"디펜히드라민 (수면유도제)","s":"약국 수면유도제 — 며칠만, 65세 이상은 피하기","k":["일시적 불면(며칠)","쿨드림","슬리펠정"],"u":"#/drug/diphenhydramine"},{"id":"d:doxylamine","t":"독시라민 (수면유도제)","s":"디펜히드라민보다 길게 가는 수면유도제 — 다음날 머리가 더 무거워요","k":["일시적 불면","아론정·스메르정·자멘쏙정"],"u":"#/drug/doxylamine"},{"id":"d:scopolamine","t":"스코폴라민 패치 (키미테)","s":"출발 4시간 전 귀 뒤에 — 어린이용은 처방약","k":["멀미 예방(장거리)","키미테","어린이"],"u":"#/drug/scopolamine"},{"id":"d:dimenhydrinate","t":"디멘히드리네이트 (보나링에이)","s":"타기 30분~1시간 전 먹는 멀미약 — 졸음은 각오","k":["멀미 예방","보나링에이정"],"u":"#/drug/dimenhydrinate"},{"id":"d:fusidic-acid","t":"퓨시드산 (후시딘)","s":"바르는 항생제 — 감염된 상처에만, 단순 긁힘엔 불필요","k":["감염된 상처","농가진","모낭염","후시딘"],"u":"#/drug/fusidic-acid"},{"id":"d:mupirocin","t":"무피로신 (박트로반 등)","s":"후시딘과 효과가 같은 바르는 항생제 — 제품에 따라 처방이 필요해요","k":["감염된 상처","농가진","무피신연고","메타로신연고","닥터로반연고"],"u":"#/drug/mupirocin"},{"id":"d:terbinafine","t":"테르비나핀 크림 (라미실)","s":"발 무좀엔 1~2주 바르기 — 발톱 무좀은 먹는 약(처방)","k":["발 무좀","완선·체부백선","라미실"],"u":"#/drug/terbinafine"},{"id":"d:triamcinolone","t":"트리암시놀론 연고 (오라메디)","s":"구내염에 바르는 스테로이드 — 헤르페스·곰팡이엔 금지","k":["아프타성 구내염","오라메디"],"u":"#/drug/triamcinolone"},{"id":"d:policresulen","t":"폴리크레줄렌 (알보칠)","s":"구내염에 ‘지지는’ 약 — 아프지만 빠름, 희석해서","k":["구내염","알보칠"],"u":"#/drug/policresulen"},{"id":"d:artificial-tears","t":"인공눈물 (카복시메틸셀룰로스·히알루론산)","s":"일회용은 뜯고 바로, 방부제 있는 것은 하루 4회 이내","k":["안구건조","눈 피로·이물감","리프레시"],"u":"#/drug/artificial-tears"},{"id":"d:pancol-a","t":"판콜에이 내복액","s":"편의점 종합감기약 — 1병에 아세트아미노펜 300 mg","k":["감기 종합(콧물·기침·몸살)","판콜에이"],"u":"#/drug/pancol-a"},{"id":"d:pancol-s","t":"판콜에스 내복액","s":"약국 종합감기약 — 판콜에이와 성분이 달라요(메틸에페드린)","k":["감기 종합(콧물·기침·몸살)","판콜에스"],"u":"#/drug/pancol-s"},{"id":"d:panpyrin-t","t":"판피린티정","s":"편의점에서 사는 알약 감기약 — 성분 3가지","k":["감기 종합","판피린티정"],"u":"#/drug/panpyrin-t"},{"id":"d:panpyrin-q","t":"판피린큐액","s":"약국 물약 감기약 — 기침·가래·기관지 성분까지 6가지","k":["감기 종합","판피린큐액"],"u":"#/drug/panpyrin-q"},{"id":"d:theraflu","t":"테라플루 (데이·나이트)","s":"1포에 아세트아미노펜 650 mg — 타이레놀과 절대 겹치지 말 것","k":["감기 몸살·발열·코막힘","테라플루","테라플루"],"u":"#/drug/theraflu"},{"id":"d:coldaewon","t":"콜대원 콜드에스시럽","s":"콧물·기침·몸살이 골고루 — 슈도에페드린은 없어요","k":["감기(증상별)","콜대원"],"u":"#/drug/coldaewon"},{"id":"d:coldaewon-cough","t":"콜대원 코프에스시럽","s":"기침·가래가 주 증상일 때 — 졸리는 콧물 성분은 없어요","k":["감기(증상별)","콜대원"],"u":"#/drug/coldaewon-cough"},{"id":"d:coldaewon-nose","t":"콜대원 노즈에스시럽","s":"콧물·코막힘이 주 증상일 때 — 기침 성분은 없어요","k":["감기(증상별)","콜대원"],"u":"#/drug/coldaewon-nose"},{"id":"d:tylenol-cold","t":"타이레놀 콜드-에스정","s":"타이레놀 이름이지만 4가지 성분 — 타이레놀정과 함께 먹지 말 것","k":["감기 종합(콧물·코막힘·기침·몸살)","타이레놀"],"u":"#/drug/tylenol-cold"},{"id":"d:geworin","t":"게보린정","s":"두통약의 대명사 — 15세 미만 금지, 매일 먹는 약은 아님","k":["두통","치통","생리통","게보린정"],"u":"#/drug/geworin"},{"id":"d:penzal","t":"펜잘큐정","s":"게보린과 닮은꼴 — 피린 대신 살리실산계","k":["두통","치통","생리통","펜잘큐정"],"u":"#/drug/penzal"},{"id":"d:gnalen","t":"그날엔정","s":"생리통 광고 약 — 이부프로펜 75 mg에 진정 성분이 붙어 있어요","k":["생리통","두통","그날엔정"],"u":"#/drug/gnalen"},{"id":"d:easy6-eve","t":"이지엔6 이브","s":"이부프로펜 + 붓기 빼는 파마브롬 — 생리 전 붓기 있을 때","k":["생리통 + 붓기","이지엔6"],"u":"#/drug/easy6-eve"},{"id":"d:relax-combo","t":"클로르족사존 복합제 (신신플렉스·클리담·리렉스담)","s":"근육 뭉침에 쓰는 약국 복합 근이완제","k":["담 결림","근육 뭉침","갑자기 온 허리 통증(보조)","신신플렉스정·클리담정·마이펜엑스정·리렉스담정"],"u":"#/drug/relax-combo"},{"id":"d:clotrimazole","t":"클로트리마졸 크림 (아졸계 무좀약)","s":"무좀·완선·칸디다에 두루 쓰는 기본 항진균 크림","k":["발 무좀","완선(사타구니)","어루러기","피부 칸디다","카네스텐","카네스텐"],"u":"#/drug/clotrimazole"},{"id":"d:amorolfine","t":"아모롤핀 네일라카 (발톱 무좀)","s":"발톱 무좀에 일주일 1~2번 바르는 매니큐어형 — 6~12개월","k":["손발톱 무좀(조갑백선)","로세릴"],"u":"#/drug/amorolfine"},{"id":"d:hemorrhoid-topical","t":"치질 연고·좌약","s":"아픔·가려움을 바로 눅여 주는 바르는 약 — 1주 이내로","k":["치핵 통증","항문 가려움","배변 시 출혈","약국"],"u":"#/drug/hemorrhoid-topical"},{"id":"d:diosmin","t":"디오스민 (먹는 치질약)","s":"출혈·가려움을 줄이는 먹는 치질약 — 통증에는 근거가 약해요","k":["치핵 출혈","항문 가려움·불편감","하지정맥 붓기","디오라인정·나노디오정·디오맥스정"],"u":"#/drug/diosmin"},{"id":"d:antihistamine-topical","t":"바르는 가려움약 (물린 데·두드러기)","s":"모기·벌레 물린 자리에 시원하게 — 넓게 오래는 금지","k":["모기·벌레 물림","가벼운 두드러기","땀띠","약국"],"u":"#/drug/antihistamine-topical"},{"id":"d:oxytetracycline-eye","t":"안연고 (항생제)","s":"다래끼·눈꺼풀 염증에 짧게 — 온찜질이 먼저예요","k":["다래끼(맥립종)","가벼운 눈꺼풀염","약국"],"u":"#/drug/oxytetracycline-eye"},{"id":"d:colchicine","t":"콜히친 (통풍 발작)","s":"통풍 발작 초기 24시간 안에 — 저용량이 원칙","k":["갑자기 온 통풍 발작","요산강하제 시작 초기의 발작 예방","콜히친"],"u":"#/drug/colchicine"},{"id":"d:allopurinol","t":"알로퓨리놀 (요산 낮추는 약)","s":"통풍의 진짜 치료 — 발작이 아니라 요산을 낮춘다","k":["반복되는 통풍","통풍 결절(토푸스)","요산 결석","알로퓨리놀"],"u":"#/drug/allopurinol"},{"id":"d:acyclovir","t":"아시클로버 (대상포진 항바이러스제)","s":"발진 생긴 지 72시간 안에 시작해야 효과가 커요","k":["대상포진","단순포진(입술·성기)","아시클로버·발라시클로버·팜시클로버"],"u":"#/drug/acyclovir"},{"id":"d:betahistine","t":"베타히스틴 (어지럼)","s":"메니에르병 등 속귀 어지럼에 쓰는 처방약","k":["메니에르병","속귀성 어지럼","베타히스틴"],"u":"#/drug/betahistine"},{"id":"d:ors","t":"경구수액 (전해질 보충)","s":"장염 치료의 진짜 주인공 — 지사제보다 이게 먼저예요","k":["갑자기 생긴 장염·설사","구토 후 탈수","더위·땀으로 인한 탈수","약국"],"u":"#/drug/ors"},{"id":"d:ondansetron","t":"온단세트론 (구토 억제)","s":"토해서 물도 못 넘길 때 — 처방으로 한 번","k":["갑자기 온 장염의 구토","항암·수술 후 구역","온단세트론"],"u":"#/drug/ondansetron"},{"id":"d:amoxicillin","t":"아목시실린 (페니실린계)","s":"가장 많이 쓰는 기본 항생제 — 감기엔 쓰지 않아요","k":["세균성 인두염","중이염","부비동염","지역사회 폐렴","헬리코박터 제균(같이 쓸 때)","아목시실린"],"u":"#/drug/amoxicillin"},{"id":"d:amox-clav","t":"아목시실린·클라불란산 (오구멘틴)","s":"아목시실린이 안 듣는 균까지 — 설사가 더 흔해요","k":["재발·난치성 중이염·부비동염","동물·사람에게 물린 상처","복잡한 피부 감염","아목시실린·클라불란산"],"u":"#/drug/amox-clav"},{"id":"d:cefaclor","t":"세팔로스포린계 (세파클러 등)","s":"페니실린과 사촌 — 알레르기 병력을 꼭 말씀하세요","k":["인두염·중이염","피부 연조직 감염","요로감염","세파클러·세프디니르"],"u":"#/drug/cefaclor"},{"id":"d:azithromycin","t":"아지트로마이신 (마크로라이드계)","s":"3~5일만 먹는 항생제 — 페니실린 알레르기 대안","k":["비정형 폐렴(마이코플라스마 등)","백일해","페니실린 알레르기 시 인두염 대안","아지트로마이신"],"u":"#/drug/azithromycin"},{"id":"d:fosfomycin","t":"포스포마이신 (방광염 1회 요법)","s":"단순 방광염에 한 포, 한 번으로 끝","k":["단순 방광염(합병증 없는 여성)","포스포마이신"],"u":"#/drug/fosfomycin"},{"id":"d:ciprofloxacin","t":"시프로플록사신 (퀴놀론계)","s":"센 항생제 — 어르신은 힘줄·혈관 부작용을 조심","k":["신우신염","복잡성 요로감염","일부 세균성 장염","시프로플록사신·레보플록사신"],"u":"#/drug/ciprofloxacin"},{"id":"d:antibiotic-eyedrop","t":"항생제 안약","s":"세균성 결막염에 — 대부분은 안 써도 나아요","k":["세균성 결막염","눈꺼풀염","항생제","설파메톡사졸"],"u":"#/drug/antibiotic-eyedrop"},{"id":"d:benzydamine","t":"벤지다민 가글·스프레이 (탄툼)","s":"아픈 곳에 직접 — 구내염·인후통 가글, 약국에서 살 수 있어요","k":["구내염","인후통","편도 수술 후 통증","항암·방사선 구강점막염","삼아탄툼액","탄툼베르데네뷸라이저","디프람스프레이0.3%"],"u":"#/drug/benzydamine"},{"id":"d:chlorhexidine","t":"클로르헥시딘 가글 (헥사메딘)","s":"입안 세균을 줄이는 소독 가글 — 통증은 못 잡아요","k":["잇몸 염증","발치 후 구강 관리","구내염 2차 감염 예방","헥사메딘액0.12%","그린헥시딘가글액0.12%","울티클가글액0.12%"],"u":"#/drug/chlorhexidine"},{"id":"d:mirabegron","t":"미라베그론 (베타미가)","s":"과민성 방광약 — 어르신께 기억력 부담이 적은 쪽","k":["과민성 방광","절박성 요실금","빈뇨·야간뇨","베타미가서방정","미라벡서방정·셀레베타서방정"],"u":"#/drug/mirabegron"},{"id":"d:solifenacin","t":"솔리페나신 (베시케어)","s":"가장 많이 쓰는 과민성 방광약 — 어르신은 항콜린 부담을 확인","k":["과민성 방광","절박성 요실금","빈뇨·야간뇨","베시케어정","솔리신정·큐어나신정"],"u":"#/drug/solifenacin"},{"id":"d:tamsulosin","t":"탐스로신 (하루날디)","s":"전립선비대 — 소변 길을 넓혀 주는 약","k":["전립선비대증","소변 줄기 약함·잔뇨감","야간뇨","하루날디정","한미탐스오디정·수로신디정"],"u":"#/drug/tamsulosin"},{"id":"d:bisphosphonate","t":"비스포스포네이트 (포사맥스·악토넬)","s":"골다공증 1차 치료제 — 먹는 법을 지켜야 효과가 나요","k":["골다공증","골절 예방","스테로이드 오래 드셔서 생기는 뼈 손실","포사맥스플러스디정","악토넬정·리스넬정"],"u":"#/drug/bisphosphonate"},{"id":"d:vitamin-d-rx","t":"비타민D (콜레칼시페롤)","s":"골다공증 치료의 짝 — 다만 '먹으면 골절이 준다'는 아니에요","k":["비타민D 결핍","골다공증 치료 보조","햇빛을 거의 못 보는 경우","비타민D","디맥정"],"u":"#/drug/vitamin-d-rx"},{"id":"d:trimebutine","t":"트리메부틴 (포리부틴)","s":"쥐어짜는 아픔을 푸는 약 — 어르신께 부담이 적은 쪽","k":["배가 꼬이는 복통","과민성 장 증상","방광이 쥐어짜듯 아플 때","소화불량","포리부틴정","레큐틴정·가스부틴정"],"u":"#/drug/trimebutine"},{"id":"d:tiropramide","t":"티로프라미드 (티로파)","s":"경련성 통증에 병원에서 쓰는 진경제","k":["방광염의 경련성 통증","요로결석 산통","담도·장 경련","티로파정","티램정·프로파정"],"u":"#/drug/tiropramide"},{"id":"d:butylscopolamine","t":"부틸스코폴라민 (부스코판)","s":"배가 꼬일 때 약국에서 — 어르신은 조건을 먼저 확인","k":["배가 꼬이는 복통","생리통","장 경련","부스코판당의정"],"u":"#/drug/butylscopolamine"},{"id":"d:mht","t":"폐경호르몬요법 (에스트로겐·티볼론)","s":"갱년기 증상에 가장 잘 듣는 치료 — 시작 시기가 이득을 갈라요","k":["갱년기 열감·식은땀","폐경 뒤 불면·기분 변화","질 건조·성교통","조기 폐경","에스트로펨정","리비알정","프레마린정"],"u":"#/drug/mht"},{"id":"rx:bp","t":"혈압약을 드시는 분께","s":"깜빡했을 때 · 약국 약 조심 · 약을 바꾸는 이유","k":["처방약","복용법"],"u":"#/rx/bp"},{"id":"rx:dm","t":"당뇨약을 드시는 분께","s":"저혈당 대처 · 아픈 날 · 조영 검사 전","k":["처방약","복용법"],"u":"#/rx/dm"},{"id":"rx:chol","t":"콜레스테롤약(…스타틴)을 드시는 분께","s":"근육통 · 간 수치 · 약을 바꾸는 이유","k":["처방약","복용법"],"u":"#/rx/chol"},{"id":"rx:thy","t":"갑상선약(레보티록신)을 드시는 분께","s":"아침 빈속 · 4시간 띄울 것 · 피검사 시기","k":["처방약","복용법"],"u":"#/rx/thy"},{"id":"rx:mind","t":"수면제·안정제·우울약을 드시는 분께","s":"같이 먹으면 안 되는 약 · 끊을 때 · 잠결 행동","k":["처방약","복용법"],"u":"#/rx/mind"},{"id":"rx:blood","t":"피 묽게 하는 약을 드시는 분께","s":"출혈 신호 · 약국 약 조심 · 시술 전","k":["처방약","복용법"],"u":"#/rx/blood"},{"id":"rx:bone","t":"골다공증약(…드론산)을 드시는 분께","s":"아침 빈속 · 맹물 한 컵 · 30분 눕지 않기 · 치과 전 말하기","k":["처방약","복용법"],"u":"#/rx/bone"},{"id":"rx:gi","t":"위산 억제제(…프라졸·…프라잔)를 드시는 분께","s":"식사 전 · 스스로 끊지 않기 · 1년에 한 번 아직 필요한지","k":["처방약","복용법"],"u":"#/rx/gi"},{"id":"rx:resp","t":"흡입기(천식·만성 폐쇄성 폐질환)를 쓰시는 분께","s":"매일 쓰는 약 · 숨찰 때 쓰는 약 구분 · 입 헹구기 · 쓰는 법 확인","k":["처방약","복용법"],"u":"#/rx/resp"},{"id":"rx:pros","t":"전립선약(…로신·…스테리드)을 드시는 분께","s":"처음엔 일어설 때 천천히 · 백내장 수술 전 말하기 · 효과는 몇 달","k":["처방약","복용법"],"u":"#/rx/pros"},{"id":"rx:gout","t":"통풍약(알로퓨리놀·페북소스타트·콜히친)을 드시는 분께","s":"요산 약은 매일 · 발작이 와도 끊지 않기 · 발진이면 바로 멈춤","k":["처방약","복용법"],"u":"#/rx/gout"},{"id":"rx:blad","t":"방광약(…페나신·미라베그론)을 드시는 분께","s":"효과는 몇 주 · 입마름·변비 · 어르신은 기억력 살피기","k":["처방약","복용법"],"u":"#/rx/blad"},{"id":"rx:ster","t":"먹는 스테로이드(프레드니솔론·메틸프레드니솔론)를 드시는 분께","s":"아침 식후 · 오래 먹었으면 갑자기 끊지 않기 · 혈당·잠·뼈","k":["처방약","복용법"],"u":"#/rx/ster"},{"id":"rx:dem","t":"치매약(도네페질·메만틴)을 드시는 분께","s":"매일 같은 때 · 처음엔 속 불편 · 맥이 느려지면 말하기 · 졸리는 약 피하기","k":["처방약","복용법"],"u":"#/rx/dem"},{"id":"rx:eye","t":"녹내장 안약을 넣으시는 분께","s":"매일 같은 때 · 두 가지면 5분 띄우기 · 눈 안쪽 누르기","k":["처방약","복용법"],"u":"#/rx/eye"},{"id":"rx:park","t":"파킨슨약을 드시는 분께","s":"시간 지키기 · 갑자기 끊지 않기 · 일어설 때 천천히 · 충동·졸음 살피기","k":["처방약","복용법"],"u":"#/rx/park"},{"id":"rx:pain","t":"병원에서 받은 진통제(소염진통제·트라마돌·신경통약)를 드시는 분께","s":"약국 진통제와 겹치지 않기 · 졸음·어지럼 · 술 금지","k":["처방약","복용법"],"u":"#/rx/pain"},{"id":"rx:abx","t":"병원에서 받은 항생제·무좀약을 드시는 분께","s":"정한 날짜대로 · 스스로 끊지 않기 · 약마다 피할 것","k":["처방약","복용법"],"u":"#/rx/abx"},{"id":"rx:derm","t":"피부과에서 받은 먹는 약(이소트레티노인·…사이클린)을 드시는 분께","s":"이소트레티노인은 임신 절대 금지 · …사이클린은 물 한 컵·눕지 않기 · 햇빛 조심","k":["처방약","복용법"],"u":"#/rx/derm"},{"id":"rx:herb","t":"한약·한방 과립제를 드시는 분께","s":"병원 약과 함께면 꼭 말하기 · 감초·마황 · 오래 드시면 확인","k":["처방약","복용법"],"u":"#/rx/herb"}]}