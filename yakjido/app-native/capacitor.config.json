{
  "appId": "kr.yakjido.app",
  "appName": "약지도",
  "webDir": "www",
  "android": {
    "allowMixedContent": false
  },
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": false,
      "backgroundColor": "#2A829F",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    },
    "StatusBar": {
      "overlaysWebView": false,
      "style": "LIGHT",
      "backgroundColor": "#FAF8F3"
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_pill",
      "iconColor": "#0B6E8F"
    }
  }
}
