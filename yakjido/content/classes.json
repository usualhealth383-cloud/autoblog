[
{
  "id": "nsaid", "name": "소염진통제", "short": "소염진통제", "icon": "bone",
  "lead": "염증을 가라앉혀 통증을 줄이는 약들이에요. 효과는 서로 비슷하지만 **위장 부담과 심혈관 부담이 성분마다 달라서**, 진료실에서는 환자의 위·심장·신장 상태를 보고 골라요. 약국에서 살 수 있는 것은 이부프로펜·덱시부프로펜·나프록센·아스피린(진통용량)이고, 나머지는 처방약이에요.",
  "chartTitle": "위장 부담 × 심혈관 부담 — 한눈에",
  "chartNote": "가로축은 SOS 프로젝트(Castellsague 2012)의 상부위장관 합병증 상대위험, 세로축은 CNT 2013·PRECISION의 심혈관 사건 위험을 5단계로 옮긴 값이에요. 낮은 용량·짧은 기간에서는 모두 위험이 줄고, 개인 조건(위궤양 병력·심장병·신장)에 따라 순위가 바뀌어요.",
  "chartSources": ["castellsague2012", "cnt2013", "precision2016"],
  "members": ["ibuprofen", "dexibuprofen", "naproxen", "aspirin", "celecoxib", "aceclofenac", "diclofenac", "meloxicam", "loxoprofen"],
  "columns": [{"key": "otc", "label": "구입"}, {"key": "gi", "label": "위장"}, {"key": "cv", "label": "심혈관"}, {"key": "dur", "label": "지속"}, {"key": "pick", "label": "이런 분께"}],
  "table": [
    {"drug": "ibuprofen", "otc": "약국", "gi": "낮은 편 (RR 1.84)", "cv": "저용량 낮음", "dur": "4~6시간", "pick": "대부분의 급성 통증 첫 선택. 위가 약한 분(단, 저용량)"},
    {"drug": "dexibuprofen", "otc": "약국", "gi": "이부프로펜 급 [확인 필요]", "cv": "이부프로펜 급", "dur": "6~8시간", "pick": "이부프로펜과 같되 알약 수를 줄이고 싶을 때"},
    {"drug": "naproxen", "otc": "약국", "gi": "높은 편 (RR 4.10)", "cv": "**가장 낮음** (RR 0.93)", "dur": "8~12시간", "pick": "고혈압·심장병이 있는 분, 생리통(부하용량), 밤새 가야 할 때"},
    {"drug": "aspirin", "otc": "약국", "gi": "높음", "cv": "항혈소판(출혈↑)", "dur": "4~6시간", "pick": "진통 목적으로는 권하지 않음. 15세 미만 금지"},
    {"drug": "celecoxib", "otc": "처방", "gi": "**가장 낮음** (RR 1.45)", "cv": "200 mg에서 나프록센과 비열등", "dur": "12~24시간", "pick": "위궤양 병력·장기 복용 필요 → 진료 후 처방"},
    {"drug": "aceclofenac", "otc": "처방", "gi": "낮음 추정 (RR 1.43, CI 넓음)", "cv": "자료 부족", "dur": "12시간", "pick": "국내 처방 1순위급. 처방받았다면 약국 소염제 금지"},
    {"drug": "diclofenac", "otc": "처방(겔은 약국)", "gi": "중간 (RR 3.34)", "cv": "**가장 높음** (RR 1.41)", "dur": "8시간", "pick": "국소 통증은 겔로 — 먹는 약은 심장병에 비권장"},
    {"drug": "meloxicam", "otc": "처방", "gi": "중간 (RR 3.47)", "cv": "자료 부족", "dur": "24시간", "pick": "하루 한 번이 편한 만성 관절염"},
    {"drug": "loxoprofen", "otc": "처방(패치는 약국)", "gi": "중간 [확인 필요]", "cv": "자료 부족", "dur": "6~8시간", "pick": "국소 통증은 패치가 먹는 약과 동등"}
  ],
  "verdict": [
    "**위가 약하다(속쓰림·궤양 병력)** → 저용량 이부프로펜(하루 1,200 mg 이하) + 파모티딘. 궤양 병력이 뚜렷하면 약국 소염제 대신 진료(셀레콕시브 + 강한 위산 억제제(처방)).",
    "**고혈압·심장병·뇌졸중 병력** → 나프록센이 심혈관 면에서 가장 안전. 디클로페낙·고용량 이부프로펜은 피하기. 어떤 소염제든 ‘첫 주부터’ 위험이 시작되니 짧게.",
    "**신장이 나쁘다·이뇨제·혈압약(안지오텐신 계열)** → 소염제 자체를 피하고 아세트아미노펜 + 파스. 꼭 필요하면 의사와.",
    "**임신 20주 이후** → 모든 소염진통제 금기, 아세트아미노펜만.",
    "**천식(특히 비용종·아스피린 과민)** → 소염진통제 회피, 아세트아미노펜.",
    "**65세 이상** → 어떤 소염제든 위보호제와 함께, 최단기간. 파스·겔을 먼저.",
    "**어느 것도 해당 없음** → 이부프로펜 200~400 mg으로 시작. 오래 가야 하면 나프록센."
  ],
  "notes": [
    "소염제는 **한 번에 한 가지**만. 두 가지를 겹치면 효과는 안 늘고 위장·신장 부담만 더해져요.",
    "아세트아미노펜은 계열이 달라 소염제와 **함께** 먹을 수 있고, 함께 먹으면 각각 단독보다 잘 들어요(코크란 NNT 1.5).",
    "저용량 아스피린(심장)을 드시는 분은 이부프로펜을 아스피린 2시간 뒤에 — 먼저 먹으면 아스피린 효과가 막혀요.",
    "국소 통증(무릎·손목·어깨)은 붙이는·바르는 소염제가 먹는 약과 비슷한 효과에 전신 부작용이 거의 없어요(코크란 NNT 1.8~3.9)."
  ],
  "sources": ["castellsague2012", "cnt2013", "precision2016", "bally2017", "masclee2014", "catella2001", "fda2020nsaid", "rajan2015", "derry2015topical", "derry2013combo"]
},
{
  "id": "analgesic", "name": "해열진통제(아세트아미노펜·복합)", "short": "해열진통", "icon": "temp",
  "lead": "염증 작용 없이 통증·열을 잡는 아세트아미노펜과, 여기에 카페인·이소프로필안티피린·에텐자미드를 더한 복합진통제(게보린·펜잘)예요. 핵심은 **아세트아미노펜 하루 총량 4 g**과 **복합진통제 월 10일 이내**예요.",
  "chartTitle": "위장 부담 × 심혈관 부담",
  "members": ["acetaminophen", "ipa", "ethenzamide", "caffeine", "pamabrom"],
  "columns": [{"key": "otc", "label": "구입"}, {"key": "who", "label": "특징"}, {"key": "pick", "label": "고를 때"}],
  "table": [
    {"drug": "acetaminophen", "otc": "편의점", "who": "위장·심장·신장 부담 최소. 간은 총량 관리", "pick": "모든 통증의 바탕. 임신·위약·노인 1순위"},
    {"drug": "ipa", "otc": "약국(게보린)", "who": "피린계. 15세 미만 금지, 장기 복용 금지", "pick": "가끔 심한 두통 한두 번"},
    {"drug": "ethenzamide", "otc": "약국(펜잘)", "who": "살리실산계. 15세 미만·아스피린 알레르기 금지", "pick": "게보린 대체"},
    {"drug": "caffeine", "otc": "복합제", "who": "진통 보조. 월 10일↑ 약물과용두통", "pick": "저녁엔 카페인 없는 단일제로"},
    {"drug": "pamabrom", "otc": "복합제", "who": "약한 이뇨. 생리 전 붓기", "pick": "붓기 없으면 불필요"}
  ],
  "verdict": ["두통이 한 달에 10일 이상이면 진통제를 바꿀 게 아니라 진료(약물과용두통·편두통 예방치료).", "복합진통제보다 ‘아세트아미노펜 + 이부프로펜’ 두 단일제 조합이 근거상 더 강하고 조절이 쉬워요."],
  "notes": ["감기약 대부분에 아세트아미노펜 300~650 mg이 들어 있어요. 타이레놀과 겹치지 않게 ‘내 약통’에 등록해 두세요."],
  "sources": ["mfds_tylenol", "fda_apap", "mfds_geworin", "ichd3", "derry2013combo"]
},
{
  "id": "relaxant", "name": "근이완제", "short": "근이완제", "icon": "bone",
  "lead": "근육의 긴장·경직을 풀어 통증을 줄여요. 급성 요통에서 효과는 ‘작지만 있음’(BMJ 2021)이고, 진료실에서는 소염제와 짝지어 3~5일 짧게 처방해요. **약국 일반약은 클로르족사존 3제 복합제뿐**이고, 에페리손·사이클로벤자프린·티자니딘·바클로펜은 처방약이에요.",
  "chartTitle": "위장 부담 × 심혈관 부담",
  "members": ["chlorzoxazone", "eperisone", "cyclobenzaprine"],
  "columns": [{"key": "otc", "label": "구입"}, {"key": "sed", "label": "졸음"}, {"key": "pick", "label": "고를 때"}],
  "table": [
    {"drug": "chlorzoxazone", "otc": "약국(복합제)", "sed": "있음", "pick": "담 결림에 소염제와 함께 며칠"},
    {"drug": "eperisone", "otc": "처방", "sed": "적은 편", "pick": "낮에도 써야 하는 근골격 통증 — 국내 처방 표준"},
    {"drug": "cyclobenzaprine", "otc": "처방", "sed": "강함", "pick": "밤에 경련으로 못 잘 때, 2~3주 이내"}
  ],
  "verdict": ["담이 3일 넘게 안 풀리거나 팔다리로 저림이 내려가면 약국 조합을 늘리지 말고 진료.", "65세 이상은 근이완제 졸음으로 낙상 위험 — 파스·온찜질을 먼저."],
  "notes": ["근이완제는 ‘통증 자체’보다 ‘뭉침·경직’을 푸는 약이라 소염제 없이 단독으로는 효과가 약해요."],
  "sources": ["cashin2021", "cashin2023", "acp2017", "kpa_relaxant"]
},
{
  "id": "gi-acid", "name": "위산·속쓰림약", "short": "속쓰림", "icon": "stomach",
  "lead": "**지금 당장** 끄는 제산제(겔포스·알마겔·개비스콘)와 **분비 자체를 줄이는** 파모티딘, 그리고 처방약인 강한 위산 억제제로 나뉘어요. 소염제 위보호에는 제산제가 아니라 파모티딘(약국)·강한 위산 억제제(처방)가 근거 있는 선택이에요.",
  "chartTitle": "위장 부담 × 심혈관 부담",
  "members": ["famotidine", "omeprazole", "almagate", "aluminium-phosphate", "alginate", "antacid-mg"],
  "columns": [{"key": "otc", "label": "구입"}, {"key": "onset", "label": "효과 시작"}, {"key": "dur", "label": "지속"}, {"key": "pick", "label": "고를 때"}],
  "table": [
    {"drug": "almagate", "otc": "약국", "onset": "5~15분", "dur": "1~2시간", "pick": "지금 속쓰림"},
    {"drug": "aluminium-phosphate", "otc": "약국", "onset": "5~15분", "dur": "1~2시간", "pick": "빈속 통증·취침 전"},
    {"drug": "alginate", "otc": "약국", "onset": "몇 분", "dur": "~4시간", "pick": "신물 역류·식후 가슴쓰림"},
    {"drug": "famotidine", "otc": "약국", "onset": "30~60분", "dur": "10~12시간", "pick": "소염제 위보호, 밤 속쓰림 예방 (14일 이내)"},
    {"drug": "omeprazole", "otc": "처방", "onset": "1~4일", "dur": "24시간", "pick": "역류성 식도염·궤양·장기 소염제"}
  ],
  "verdict": ["소염제를 3일 이상 먹는다 → 파모티딘 10 mg 하루 1~2회를 함께.", "2주 넘게 속쓰림약이 필요하다 → 진료(내시경·강한 위산 억제제).", "삼킴 곤란·체중 감소·검은 변·토혈 → 약을 사지 말고 바로 진료."],
  "notes": ["제산제는 다른 약의 흡수를 방해해요. 다른 약과 2시간 띄우세요.", "강한 위산 억제제(오메프라졸 등)는 국내에서 아직 처방 전용이에요(미국·영국·일본은 약국 판매)."],
  "sources": ["rostom2002", "hawkey2007", "mfds_famotidine", "ppi_otc"]
},
